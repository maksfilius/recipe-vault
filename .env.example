NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Chrome Web Store listing URL; enables "Add to Chrome" on the landing page and the library link.
# NEXT_PUBLIC_CHROME_EXTENSION_URL=https://chromewebstore.google.com/detail/<id>
# Production PostHog Cloud EU project token. Analytics remains off in development.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Keep & Cook <onboarding@resend.dev>
RESEND_TEST_TO_EMAIL=you@example.com
RESEND_TEST_TOKEN=replace-with-a-long-random-token
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Shows "Continue with Google" once the Google provider is set up in Supabase (docs/google-sign-in.md).
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
